---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { campanhasAtivas, resolverProdutos } from '../lib/campanhas';
import { u, data } from '../lib/url';
import EmCampanha from '../components/EmCampanha.astro';
import Galeria from '../components/Galeria.astro';
import Preco from '../components/Preco.astro';

const ativas = await campanhasAtivas();
const itens = await Promise.all(
  ativas.map(async (c) => ({
    c,
    Content: (await render(c)).Content,
    produtos: await resolverProdutos(c.data.produtos, c.data.titulo),
    videos: c.data.video ? (Array.isArray(c.data.video) ? c.data.video : [c.data.video]) : [],
    folhetos: c.data.folheto ? (Array.isArray(c.data.folheto) ? c.data.folheto : [c.data.folheto]) : (c.data.folhetoPdf ? [c.data.folhetoPdf] : []),
  }))
);
---
<Base titulo="Campanhas">
  <section class="hero claro">
    <div class="wrap">
      <h1>Campanhas</h1>
      <p>Ofertas e condições especiais por tempo limitado.</p>
    </div>
  </section>
  <div class="wrap">
    {itens.length === 0 && (
      <p>Neste momento não há campanhas ativas. Volte em breve ou continue a explorar a nossa <a href={u('/')}>loja</a>.</p>
    )}
    {itens.map(({ c, Content, produtos, folhetos, videos }) => (
      <article class="prosa campanha" id={c.id}>
        <h2>{c.data.titulo}</h2>
        <p class="etiqueta">De {data(c.data.dataInicio)} a {data(c.data.dataFim)}</p>
        <div class={folhetos.length > 0 ? 'campanha-layout com-folheto' : 'campanha-layout'}>
          <div class="campanha-texto">
            {c.data.imagem && <img class="campanha-img" loading="lazy" decoding="async" src={u(c.data.imagem)} alt={c.data.titulo} />}
            <p>{c.data.resumo}</p>
            <Content />
          </div>
          {folhetos.length > 0 && (
            <aside class="campanha-folheto" id={`folheto-${c.id}`} aria-label="Folheto da campanha">
              <Galeria imagens={folhetos} nome={c.data.titulo} variante="folheto" />
              {c.data.folhetoPdf && !folhetos.includes(c.data.folhetoPdf) && <a class="folheto-pdf" href={u(c.data.folhetoPdf)} target="_blank" rel="noopener">Abrir folheto em PDF</a>}
            </aside>
          )}
        </div>
        {videos.length > 0 && (
          <div class="campanha-videos">
            <Galeria imagens={videos} nome={c.data.titulo} titulo={videos.length > 1 ? 'Vídeos' : 'Vídeo'} />
          </div>
        )}
        {produtos.length > 0 && (
          <>
            <h3>Produtos desta campanha</h3>
            <ul class="grelha campanha-produtos">
              {produtos.map((p) => (
                <li class="cartao">
                  <EmCampanha />
                  {p.imagem && <img loading="lazy" decoding="async" src={u(p.imagem)} alt={p.nome} />}
                  <div class="corpo">
                    <p class="etiqueta">{p.marca}</p>
                    <a class="cobre" href={u(p.href)}><h3>{p.nome}</h3></a>
                    <p>{p.resumo}</p>
                    <Preco dados={p.dados} emCampanha />
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
        {folhetos.length > 0 && <p><a href={`#folheto-${c.id}`} data-abrir-folheto>Saber mais</a></p>}
      </article>
    ))}
  </div>
</Base>
<script>
  // "Saber mais" abre o folheto da campanha na galeria, tal como clicar no próprio folheto.
  // Sem JavaScript, a ligação limita-se a saltar para o folheto na página.
  document.querySelectorAll('a[data-abrir-folheto]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const alvo = document.querySelector(a.getAttribute('href') + ' .galeria-abrir');
      if (!alvo) return;
      e.preventDefault();
      alvo.click();
    });
  });
</script>
