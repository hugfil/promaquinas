---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base titulo="Pedido enviado" descricao="Recebemos o seu pedido de orçamento.">
  <section class="obg">
    <div class="wrap obg-cartao">
      <span class="obg-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40"><path d="M6 12.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <h1>Pedido enviado. Obrigado!</h1>
      <p>Recebemos o seu pedido de orçamento. Vamos analisá-lo e responder por email ou telefone em breve.</p>
      <div class="obg-acoes">
        <a class="botao" href={u('/')}>Voltar à página inicial</a>
      </div>
    </div>
  </section>

  <style>
    .obg { padding-block: clamp(3rem, 8vw, 6rem); background: var(--cinza-claro); }
    .obg-cartao { display: grid; justify-items: center; gap: 1rem; max-width: 40rem; padding: clamp(2rem, 5vw, 3rem); text-align: center; background: #fff; border: 1px solid var(--linha); border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, .06); }
    .obg-icone { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; color: var(--verde); background: var(--banner-fundo); border-radius: 50%; box-shadow: 0 0 0 8px rgba(245, 179, 1, .2); animation: obg-entra .5s ease-out both; }
    .obg h1 { margin: .5rem 0 0; }
    .obg p { margin: 0; max-width: 32rem; color: var(--cinza); }
    .obg-acoes { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1rem 1.5rem; margin-top: .75rem; }
    @keyframes obg-entra { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .obg-icone { animation: none; } }
  </style>
</Base>
