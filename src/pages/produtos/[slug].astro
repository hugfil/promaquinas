---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../../lib/url';
import Galeria from '../../components/Galeria.astro';
import EmCampanha from '../../components/EmCampanha.astro';
import Preco from '../../components/Preco.astro';
import { produtosEmCampanha } from '../../lib/campanhas';
import NomeMarca from '../../components/NomeMarca.astro';
import FichaDestaques from '../../components/FichaDestaques.astro';
import { contactos } from '../../lib/empresa';

export async function getStaticPaths() {
  const produtos = await getCollection('outros');
  return produtos.map((p) => ({ params: { slug: p.id }, props: { produto: p } }));
}
const { produto } = Astro.props;
const { Content } = await render(produto);
const d = produto.data;
const emCampanha = (await produtosEmCampanha()).has('produtos/' + produto.id);
const assunto = encodeURIComponent(`Pedido de informações: ${d.nome}`);
---
<Base titulo={d.nome} descricao={d.resumo}>
  <div class="wrap">
    <p><a href={u('/produtos/')}>Voltar a outros produtos</a></p>
    {emCampanha && <p class="pill-ficha"><EmCampanha /></p>}
    <h1><NomeMarca texto={d.nome} /></h1>
    <p class="etiquetas">
      <a class="etiqueta-filtro" title={'Ver todos os produtos da marca ' + d.marca} href={u('/produtos/') + '?marca=' + encodeURIComponent(d.marca)}>{d.marca}</a>
      {d.tipo && <a class="etiqueta-filtro" title={'Ver todos: ' + d.tipo} href={u('/produtos/') + '?tipo=' + encodeURIComponent(d.tipo)}>{d.tipo}</a>}
    </p>
    <p>{d.resumo}</p>
    {d.imagem && <img src={u(d.imagem)} alt={d.nome} style="max-width:100%;border-radius:6px" />}
    <Preco dados={d} emCampanha={emCampanha} ficha nota="Valor sujeito a confirmação." />
    <FichaDestaques destaques={d.destaques} caracteristicas={d.caracteristicas} galeria={d.galeria} galeriaId="galeria-produto" produto={'produtos/' + produto.id} />
    <div class="prosa"><Content /></div>
    <Galeria imagens={d.galeria} nome={d.nome} id="galeria-produto" />
    <p><a class="botao" href={`mailto:${contactos.email}?subject=${assunto}`}>Pedir informações</a></p>
  </div>
</Base>
