---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { campanhasAtivas } from '../lib/campanhas';
import { u, data } from '../lib/url';

interface Props { titulo: string; descricao?: string; }
const { titulo, descricao = 'Robots corta-relva Husqvarna e outros equipamentos para o jardim. Representante oficial Husqvarna.' } = Astro.props;

const ativas = await campanhasAtivas();
const destaque = ativas[0];

// Texto de urgência do banner (o site é reconstruído todos os dias, por isso fica atualizado)
let prazo = '';
if (destaque) {
  const hoje = new Date();
  const fim = destaque.data.dataFim;
  const dias = Math.round(
    (Date.UTC(fim.getUTCFullYear(), fim.getUTCMonth(), fim.getUTCDate()) -
      Date.UTC(hoje.getUTCFullYear(), hoje.getUTCMonth(), hoje.getUTCDate())) / 86400000
  );
  prazo = dias <= 0 ? 'Termina hoje' : dias === 1 ? 'Termina amanhã' : dias <= 14 ? 'Termina em ' + dias + ' dias' : 'Até ' + data(fim);
}
const caminho = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/', texto: 'Início', icone: true },
  { href: '/robots/', texto: 'Robots corta-relva' },
  { href: '/produtos/', texto: 'Outros produtos' },
  { href: '/campanhas/', texto: 'Campanhas' },
  { href: '/orcamento/', texto: 'Pedir Orçamento', cta: true },
];
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} | Promáquinas</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/jpeg" href={u('/imagens/logo2.jpg')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    {destaque && (
      <div class="banner">
        <div class="wrap banner-linha">
          <span class="banner-chip"><span class="banner-ponto" aria-hidden="true"></span>Campanha</span>
          <p class="banner-texto"><strong>{destaque.data.titulo}</strong> {destaque.data.resumo}</p>
          <span class="banner-prazo">{prazo}</span>
          <a class="banner-link" href={u('/campanhas/#' + destaque.id)}>Ver campanha</a>
        </div>
      </div>
    )}
    <header class="topo">
      <div class="wrap">
        <a class="marca" href={u('/')}><img src={u('/imagens/logo1.jpg')} alt="Promáquinas, página inicial" width="89" height="56" /></a>
        <nav aria-label="Principal">
          {nav.map((n) => (
            <a href={u(n.href)} class={n.cta ? 'nav-cta' : undefined} title={n.icone ? n.texto : undefined} aria-current={(n.href === '/' ? caminho === '/' : caminho.startsWith(n.href)) ? 'page' : undefined}>
              {n.icone ? (
                <>
                  <svg class="nav-icone" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" /></svg>
                  <span class="so-leitores">{n.texto}</span>
                </>
              ) : n.texto}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="rodape">
      <div class="wrap">
        <a href={u('/')}><img class="logo-rodape" src={u('/imagens/logo1.jpg')} alt="Promáquinas" width="102" height="64" /></a>
        <p>Representante oficial Husqvarna.</p>
        <p>
          Este site apresenta produtos e campanhas. Não efetuamos vendas online: peça um orçamento e entramos em contacto.
        </p>
        <p>
          <!-- SUBSTITUIR pelos dados reais -->
          Email: <a href="mailto:geral@exemplo.pt">geral@exemplo.pt</a> · Telefone: 000 000 000 ·{' '}
          <a href={u('/privacidade/')}>Política de privacidade</a>
        </p>
      </div>
    </footer>
    <button type="button" class="topo-voltar" id="topo-voltar" aria-label="Voltar ao topo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <script>
      // Animações de entrada ao fazer scroll e parallax suave no topo (desligados com "reduzir movimento")
      const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduzir && 'IntersectionObserver' in window) {
        const alvos = document.querySelectorAll('main .secao > .wrap, main > .wrap');
        const obs = new IntersectionObserver((entradas) => {
          entradas.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visivel'); obs.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -10% 0px' });
        alvos.forEach((el) => { el.classList.add('anim'); obs.observe(el); });
      }
      const fundo = document.querySelector<HTMLElement>('.hero-fundo');
      if (fundo && !reduzir && window.matchMedia('(min-width: 768px)').matches) {
        let pendente = false;
        window.addEventListener('scroll', () => {
          if (pendente) return;
          pendente = true;
          requestAnimationFrame(() => {
            fundo.style.transform = `translateY(${Math.min(window.scrollY, 1200) * 0.5}px)`;
            pendente = false;
          });
        }, { passive: true });
      }
      // Botão "Voltar ao topo": aparece depois de descer um pouco
      const voltar = document.getElementById('topo-voltar');
      if (voltar) {
        const atualizarVoltar = () => voltar.classList.toggle('ativo', window.scrollY > 600);
        window.addEventListener('scroll', atualizarVoltar, { passive: true });
        atualizarVoltar();
        voltar.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduzir ? 'auto' : 'smooth' }));
      }
    </script>
  </body>
</html>
