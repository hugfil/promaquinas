---
// Dados estruturados (schema.org/Product) para as fichas de robots e produtos.
// Sem preço nem "comprar": a loja não vende online, por isso só descrevemos o produto.
import { u } from '../lib/url';

interface Props {
  nome: string;
  marca: string;
  descricao: string;
  imagem?: string;
  galeria?: (string | { src: string })[];
  categoria?: string;
  propriedades?: { nome: string; valor: number; unidade: string }[];
}
const { nome, marca, descricao, imagem, galeria = [], categoria, propriedades = [] } = Astro.props;

const abs = (caminho: string) => new URL(u(caminho), Astro.site).href;
const limpo = (texto: string) => texto.replace(/[®™]/g, '').replace(/\s+/g, ' ').trim();
// Só imagens (a galeria pode ter PDFs ou vídeos); aceita "/imagens/a.jpg | Legenda"
const caminhos = [imagem, ...galeria.map((g) => (typeof g === 'string' ? g.split('|')[0].trim() : g.src))]
  .filter((c): c is string => Boolean(c) && /\.(jpe?g|png|webp|avif)$/i.test(c as string));
const imagens = [...new Set(caminhos)].map(abs);

const dados = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nome,
  description: descricao,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: imagens.length ? imagens : undefined,
  brand: { '@type': 'Brand', name: limpo(marca) },
  category: categoria || undefined,
  additionalProperty: propriedades.length
    ? propriedades.map((p) => ({ '@type': 'PropertyValue', name: p.nome, value: p.valor, unitText: p.unidade }))
    : undefined,
};
// "<" escapado para o texto nunca fechar o bloco por engano
const json = JSON.stringify(dados).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
